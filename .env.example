# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / NEXT_PUBLIC_SITE_URL: The URL where this site is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
NEXT_PUBLIC_SITE_URL="https://kreativereflow.com"

# Lead capture:
# Local development stores submissions in .lead-captures/leads.jsonl by default.
# Production transactional email delivery uses Brevo.
# LEAD_WEBHOOK_URL is optional for Make/Zapier/CRM routing.
LEAD_CAPTURE_DIR=".lead-captures"
LEAD_NOTIFY_EMAIL="projects@kreativereflow.com"
BREVO_API_KEY=""
BREVO_FROM_EMAIL="projects@kreativereflow.com"
BREVO_FROM_NAME="Kreative Reflow"
LEAD_WEBHOOK_URL=""
LEAD_WEBHOOK_SECRET=""

# Supabase portal backend:
# Required when wiring the authenticated client portal.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET_CLIENT_ASSETS="client-assets"
